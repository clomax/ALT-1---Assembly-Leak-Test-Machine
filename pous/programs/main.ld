(* An assembly and leak test machine for a small valve body *)

PROGRAM main
  VAR_INPUT
  END_VAR
  VAR_OUTPUT
  END_VAR
  VAR
    Part_Serial : DINT := 0; (* Current sequence step *)
    Part_Serial_Out : UINT AT %QW0;
    EStop_OK : BOOL AT %IX0.0 := 1;
    Guard_Closed : BOOL AT %IX0.1 := 0;
    Start_PB : BOOL AT %IX0.2 := 0;
    Stop_PB : BOOL AT %IX0.3 := 1;
    Reset_PB : BOOL AT %IX0.4 := 0; (* Fault reset pushbutton *)
    Pallet_At_Load : BOOL AT %IX0.5 := 0;
    Part_Present : BOOL AT %IX0.6 := 0;
    CapPress_Extended : BOOL AT %IX0.7 := 0;
    CapPress_Retracted : BOOL AT %IX1.0 := 1;
    Lamp_Running : BOOL AT %QX0.0 := 0;
    CapPress_Extend : BOOL AT %QX0.1; (* Extend solenoid (spring return so off means retract) *)
    Fault_Active : BOOL AT %QX0.2 := 0;
    Machine_Healthy : BOOL := 0;
    Running : BOOL := 0;
    Load_Ready : BOOL;
    CapPress_Req_Extend : BOOL; (* Request from the sequence. No sequence yet so force this by hand for testing *)
    CapPress_ExtTimer : TON; (* Timer instance *)
    CapPress_RetTimer : TON;
    CapPress_Ext_TO : BOOL;
    CapPress_Ret_TO : BOOL;
    Reset_Allowed : BOOL AT %QX0.3;
    Fault_CapPress_ExtTimeout : BOOL;
    Fault_CapPress_RetTimeout : BOOL; (* Cap press didn't go home in time *)
    Fault_CapPress_Sensor : BOOL; (* Both sensors on at once *)
    Fault_PartRemoved : BOOL;
    FB_SEQUENCE : FB_Sequence;
    Lamp_LeakTest : BOOL AT %QX0.4 := 0;
  END_VAR
  VAR CONSTANT
    CapPress_Timeout : TIME := T#3s; (* Solenoid extend/retract timeout *)
  END_VAR
  VAR_EXTERNAL
  END_VAR
  VAR_IN_OUT
  END_VAR

